# Copy to .env.production; never commit the completed file.
# Use --env-file .env.production on every docker compose command.
NODE_ENV=production
GAMESTUDIO_MODE=production
# Use staging while testing merchant sandbox accounts; production rejects them.
GAMESTUDIO_DEPLOYMENT=production
GAMESTUDIO_DOMAIN=
ACME_EMAIL=
GAMESTUDIO_PUBLIC_URL=
# Keep this identical to GAMESTUDIO_PUBLIC_URL.
APP_BASE_URL=
# Generate a random secret: openssl rand -hex 32
GAMESTUDIO_SESSION_SECRET=
GAMESTUDIO_HOST=0.0.0.0
GAMESTUDIO_PROXY_HOPS=1
GAMESTUDIO_DATA_DIR=/var/lib/gamestudio
PORT=4100
GAMESTUDIO_SESSION_HOURS=168
GAMESTUDIO_JOB_TIMEOUT_MS=900000
GAMESTUDIO_MAX_PROJECTS=100
GAMESTUDIO_MAX_JOB_HISTORY=1000
GAMESTUDIO_MAX_TENANT_BYTES=1073741824
# All generation uses exactly gpt-6.1-sol, with no fallback model.
# API key recommended for programmatic execution. Alternatively provision a
# legitimate eligible CLI login in the private codex_auth volume and leave blank.
OPENAI_API_KEY=

# Google Web OAuth client. Authorized redirect URI:
# https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Twilio Verify SMS service, six-digit verification codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional destination calling-code allowlist, such as +1,+86.
GAMESTUDIO_PHONE_COUNTRIES=

# Configure Stripe or Alipay, or both; at least one paid checkout is required.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
# Optional safe configuration; absent means the app creates its own safe portal.
STRIPE_PORTAL_CONFIGURATION_ID=
# Register /api/billing/webhooks/stripe with the events in docs/billing.md.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# PEM RSA keys, public-key mode. Single-line literal \\n escapes are supported.
# Quote values if needed by your secret manager or Compose env-file parser.
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=false
ALIPAY_PRO_MONTHLY_AMOUNT=
ALIPAY_PRO_YEARLY_AMOUNT=
ALIPAY_STUDIO_MONTHLY_AMOUNT=
ALIPAY_STUDIO_YEARLY_AMOUNT=
BILLING_FREE_MONTHLY_GENERATIONS=5
BILLING_PRO_MONTHLY_GENERATIONS=100
BILLING_STUDIO_MONTHLY_GENERATIONS=500
