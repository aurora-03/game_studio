# Local-only server. Codex authentication uses your existing CLI login.
PORT=4100
# Optional executable override. Leave unset to use the project-local Codex CLI.
# GAMESTUDIO_CODEX_BIN=/absolute/path/to/codex
# Model is fixed to gpt-6.1-sol. The server binds only to 127.0.0.1.
# Optional data directory (default ./data).
# GAMESTUDIO_DATA_DIR=/absolute/path/to/data
# Optional generation timeout in milliseconds (default 15 minutes).
GAMESTUDIO_JOB_TIMEOUT_MS=900000
