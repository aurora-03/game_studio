{
  "name": "gamestudio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local AI game creation workspace powered by Codex CLI",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node scripts/run-tests.mjs",
    "check": "tsc -b",
    "test:live": "node scripts/verify-real-generation.mjs",
    "preflight:production": "node --env-file-if-exists=.env.production scripts/preflight-production.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@openai/codex": "^0.160.0",
    "@xyflow/react": "^12.12.0",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^1.50.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
